{
  "name": "ChatHistory",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the user who sent the message"
    },
    "message": {
      "type": "string",
      "description": "The message content"
    },
    "role": {
      "type": "string",
      "enum": [
        "user",
        "assistant"
      ],
      "description": "Whether this message was from user or AI"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "text",
        "recommendations",
        "booking_assistance"
      ],
      "default": "text",
      "description": "Type of message for special handling"
    },
    "session_id": {
      "type": "string",
      "description": "Unique identifier for the chat session"
    },
    "metadata": {
      "type": "object",
      "description": "Additional data like recommendations, booking params, etc."
    }
  },
  "required": [
    "user_email",
    "message",
    "role"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": null,
    "delete": null
  }
}