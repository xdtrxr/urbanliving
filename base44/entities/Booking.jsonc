{
  "name": "Booking",
  "type": "object",
  "description": "A stay reservation. TEMPORARY: the update rule is guest-or-admin until the client that routes guest writes through cancelBooking, startStayPayment and submitBookingId is published (planned 2026-09-20); the admin-only rule is staged in base44/entities-pending-publish.",
  "properties": {
    "property_id": {
      "type": "string",
      "description": "Reference to the property"
    },
    "guest_name": {
      "type": "string"
    },
    "guest_email": {
      "type": "string"
    },
    "check_in": {
      "type": "string",
      "format": "date"
    },
    "check_out": {
      "type": "string",
      "format": "date"
    },
    "guests": {
      "type": "number"
    },
    "total_price": {
      "type": "number",
      "description": "Total price in NGN"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "cancelled",
        "completed"
      ],
      "default": "pending"
    },
    "special_requests": {
      "type": "string"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "unpaid",
        "pending_confirmation",
        "paid",
        "refunded"
      ],
      "default": "unpaid"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "paystack",
        "other"
      ],
      "default": "paystack"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp when admin approved the availability request"
    },
    "payment_started_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp when user first opened the payment page"
    },
    "transaction_hash": {
      "type": "string",
      "description": "Paystack transaction reference for audit and refunds"
    },
    "paid_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp when payment cleared and booking was confirmed"
    },
    "id_document_url": {
      "type": "string",
      "description": "URL of guest's uploaded identification document (uploaded immediately after payment)"
    },
    "id_document_type": {
      "type": "string",
      "enum": [
        "national_id",
        "drivers_license",
        "passport",
        "voters_card",
        "other"
      ],
      "description": "Type of identification document"
    },
    "id_uploaded_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp when the guest uploaded their ID"
    },
    "host_phone_override": {
      "type": "string",
      "description": "Per-booking host phone, used when the Property's default was missing and admin filled it via Telegram"
    },
    "host_name_override": {
      "type": "string",
      "description": "Per-booking host name override"
    },
    "arrival_instructions_override": {
      "type": "string",
      "description": "Per-booking arrival instructions, used when the Property's default was missing and admin filled it via Telegram"
    },
    "host_details_status": {
      "type": "string",
      "enum": [
        "complete",
        "awaiting_admin",
        "filled_by_admin",
        "default_saved"
      ],
      "description": "Tracks the host-detail fallback flow"
    },
    "cancel_reason": {
      "type": "string",
      "enum": [
        "admin_rejected",
        "payment_expired",
        "user_cancelled",
        "other"
      ],
      "description": "Why a cancelled booking ended. Distinguishes Payment Expired rows (guest can still re-book) from admin/user cancellations."
    },
    "payment_warning_pushed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Idempotency stamp for the autoCancelExpiredBookings 5-min warning push. Set once per booking; prevents duplicate warnings if the cron fires multiple times within the warning window."
    },
    "checkin_reminder_pushed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Idempotency stamp for the dailyBookingReminders check-in push. Set once per booking on the morning of check_in; prevents duplicate sends if the cron re-runs."
    },
    "checkout_reminder_pushed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Idempotency stamp for the dailyBookingReminders check-out push. Set once per booking on the morning of check_out."
    }
  },
  "required": [
    "property_id",
    "guest_name",
    "guest_email",
    "check_in",
    "check_out",
    "guests",
    "total_price"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.guest_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.guest_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.guest_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}