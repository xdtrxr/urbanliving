{
  "name": "Booking",
  "type": "object",
  "properties": {
    "property_id": {
      "type": "string",
      "description": "Reference to the property"
    },
    "guest_name": {
      "type": "string"
    },
    "guest_email": {
      "type": "string"
    },
    "check_in": {
      "type": "string",
      "format": "date"
    },
    "check_out": {
      "type": "string",
      "format": "date"
    },
    "guests": {
      "type": "number"
    },
    "total_price": {
      "type": "number",
      "description": "Total price in NGN"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "cancelled",
        "completed"
      ],
      "default": "pending"
    },
    "special_requests": {
      "type": "string"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "unpaid",
        "pending_confirmation",
        "paid",
        "refunded"
      ],
      "default": "unpaid"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "paystack",
        "other"
      ],
      "default": "paystack"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp when admin approved the availability request"
    },
    "payment_started_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp when user first opened the payment page"
    },
    "transaction_hash": {
      "type": "string",
      "description": "Paystack transaction reference for audit and refunds"
    },
    "paid_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp when payment cleared and booking was confirmed"
    }
  },
  "required": [
    "property_id",
    "guest_name",
    "guest_email",
    "check_in",
    "check_out",
    "guests",
    "total_price"
  ],
  "rls": {
    "read": {
      "guest_email": "{{user.email}}"
    },
    "write": {
      "$or": [
        {
          "guest_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}