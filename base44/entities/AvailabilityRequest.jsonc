{
  "name": "AvailabilityRequest",
  "type": "object",
  "properties": {
    "property_id": {
      "type": "string",
      "description": "ID of the property being checked"
    },
    "property_title": {
      "type": "string",
      "description": "Title of the property"
    },
    "user_email": {
      "type": "string",
      "description": "Email of the user making the request"
    },
    "user_name": {
      "type": "string",
      "description": "Name of the user"
    },
    "check_in": {
      "type": "string",
      "format": "date",
      "description": "Check-in date"
    },
    "check_out": {
      "type": "string",
      "format": "date",
      "description": "Check-out date"
    },
    "guests": {
      "type": "number",
      "description": "Number of guests"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Approval status from admin"
    },
    "admin_response": {
      "type": "string",
      "description": "Admin's response message"
    },
    "telegram_message_id": {
      "type": "string",
      "description": "Telegram message ID for tracking"
    },
    "has_conflict": {
      "type": "boolean",
      "description": "Whether there's a booking conflict"
    },
    "conflict_details": {
      "type": "object",
      "description": "Details about the conflict if any"
    }
  },
  "required": [
    "property_id",
    "property_title",
    "user_email",
    "check_in",
    "check_out",
    "guests"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}