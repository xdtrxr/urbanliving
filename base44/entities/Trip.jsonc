{
  "name": "Trip",
  "type": "object",
  "description": "A guest's trip plan. Owner-only in every direction, stated per operation rather than as a single legacy 'write' key. Nothing in the codebase writes this entity today.",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the trip, e.g., 'Paris Summer Vacation'"
    },
    "booking_id": {
      "type": "string",
      "description": "Reference to the associated booking"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "preferences": {
      "type": "object",
      "properties": {
        "pace": {
          "type": "string",
          "enum": [
            "relaxed",
            "moderate",
            "fast_paced"
          ]
        },
        "interests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "budget": {
          "type": "string",
          "enum": [
            "budget",
            "moderate",
            "luxury"
          ]
        }
      },
      "description": "User preferences for this specific trip"
    }
  },
  "required": [
    "name",
    "booking_id",
    "start_date",
    "end_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}