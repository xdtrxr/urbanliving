{
  "name": "SupportMessage",
  "type": "object",
  "properties": {
    "ticket_id": {
      "type": "string",
      "description": "Reference to the support ticket"
    },
    "sender_type": {
      "type": "string",
      "enum": [
        "user",
        "ai_agent",
        "human_agent"
      ],
      "description": "Who sent this message"
    },
    "message": {
      "type": "string",
      "description": "Content of the message"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "text",
        "solution",
        "escalation",
        "closure"
      ],
      "default": "text",
      "description": "Type of message for categorization"
    },
    "automated_response": {
      "type": "boolean",
      "default": false,
      "description": "Whether this was an automated AI response"
    },
    "helpful": {
      "type": "boolean",
      "description": "User feedback on whether the response was helpful"
    },
    "nova_draft": {
      "type": "string",
      "description": "Nova's drafted reply held for admin review (only set on user messages awaiting an admin response)"
    },
    "nova_draft_status": {
      "type": "string",
      "enum": ["pending", "sent_as_is", "edited", "replaced"],
      "description": "Outcome of admin review on the Nova draft"
    },
    "telegram_message_id": {
      "type": "string",
      "description": "Telegram message_id of the admin notification posted for this message"
    }
  },
  "required": [
    "ticket_id",
    "sender_type",
    "message"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}