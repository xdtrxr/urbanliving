{
  "name": "UserBankAccount",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the user who owns this bank account"
    },
    "bank_name": {
      "type": "string",
      "description": "Name of the Nigerian bank (e.g., GTBank, Zenith Bank)"
    },
    "bank_code": {
      "type": "string",
      "description": "Paystack bank code for the bank"
    },
    "account_number": {
      "type": "string",
      "description": "10-digit Nigerian bank account number"
    },
    "account_name": {
      "type": "string",
      "description": "Account holder name as verified by the bank"
    },
    "recipient_code": {
      "type": "string",
      "description": "Paystack transfer recipient code"
    },
    "is_primary": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is the primary withdrawal account"
    },
    "is_verified": {
      "type": "boolean",
      "default": false,
      "description": "Whether the account has been verified"
    }
  },
  "required": [
    "user_email",
    "bank_name",
    "bank_code",
    "account_number",
    "account_name"
  ],
  "rls": {
    "create": null,
    "read": {
      "data.user_email": "{{user.email}}"
    },
    "update": {
      "data.user_email": "{{user.email}}"
    },
    "delete": {
      "data.user_email": "{{user.email}}"
    }
  }
}