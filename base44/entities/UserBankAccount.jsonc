{
  "name": "UserBankAccount",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the account owner"
    },
    "bank_name": {
      "type": "string",
      "description": "Name of the bank"
    },
    "bank_code": {
      "type": "string",
      "description": "Paystack bank code"
    },
    "account_number": {
      "type": "string",
      "description": "Bank account number"
    },
    "account_name": {
      "type": "string",
      "description": "Verified account holder name"
    },
    "is_verified": {
      "type": "boolean",
      "default": false,
      "description": "Whether account is verified via Paystack"
    },
    "is_primary": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is the primary withdrawal account"
    }
  },
  "required": [
    "user_email",
    "bank_name",
    "bank_code",
    "account_number",
    "account_name"
  ]
}