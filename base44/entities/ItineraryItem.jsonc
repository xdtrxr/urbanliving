{
  "name": "ItineraryItem",
  "type": "object",
  "properties": {
    "trip_id": {
      "type": "string",
      "description": "Reference to the Trip this item belongs to"
    },
    "title": {
      "type": "string",
      "description": "Title of the event, e.g., 'Dinner at Le Jules Verne'"
    },
    "description": {
      "type": "string",
      "description": "A brief description of the item"
    },
    "category": {
      "type": "string",
      "enum": [
        "dining",
        "activity",
        "sightseeing",
        "work",
        "transport",
        "other"
      ],
      "description": "Category of the itinerary item"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "start_time": {
      "type": "string",
      "description": "e.g., '19:00'"
    },
    "end_time": {
      "type": "string",
      "description": "e.g., '21:00'"
    },
    "location_address": {
      "type": "string",
      "description": "Address of the item's location"
    },
    "cost_estimate": {
      "type": "string",
      "description": "Estimated cost, e.g., '$$$' or 'Approx. \u20ac150'"
    }
  },
  "required": [
    "trip_id",
    "title",
    "category",
    "date",
    "start_time"
  ],
  "rls": {
    "read": {
      "created_by": "{{user.email}}"
    },
    "write": {
      "created_by": "{{user.email}}"
    }
  }
}