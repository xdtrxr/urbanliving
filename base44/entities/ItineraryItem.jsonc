{
  "name": "ItineraryItem",
  "type": "object",
  "description": "One item on a Trip. Owner-only in every direction, stated per operation rather than as a single legacy 'write' key. Nothing in the codebase writes this entity today.",
  "properties": {
    "trip_id": {
      "type": "string",
      "description": "Reference to the Trip this item belongs to"
    },
    "title": {
      "type": "string",
      "description": "Title of the event, e.g., 'Dinner at Le Jules Verne'"
    },
    "description": {
      "type": "string",
      "description": "A brief description of the item"
    },
    "category": {
      "type": "string",
      "enum": [
        "dining",
        "activity",
        "sightseeing",
        "work",
        "transport",
        "other"
      ],
      "description": "Category of the itinerary item"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "start_time": {
      "type": "string",
      "description": "e.g., '19:00'"
    },
    "end_time": {
      "type": "string",
      "description": "e.g., '21:00'"
    },
    "location_address": {
      "type": "string",
      "description": "Address of the item's location"
    },
    "cost_estimate": {
      "type": "string",
      "description": "Estimated cost, e.g., '$$$' or 'Approx. \u20ac150'"
    }
  },
  "required": [
    "trip_id",
    "title",
    "category",
    "date",
    "start_time"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}