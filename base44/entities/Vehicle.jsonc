{
  "name": "Vehicle",
  "type": "object",
  "description": "A vehicle available for hire on UrbanStays. Vehicles are inventory; drivers are a separate pool (Driver entity) that gets assigned per booking by the admin. One driver can pilot many vehicles over time \u2014 admin doesn't need to onboard a driver for every car. Public read. An admin or a listings helper (User.role listing_helper) may create and update a vehicle; only an admin may delete one. What a car costs UrbanStays is on VehicleCosting, which stays admin-only.",
  "properties": {
    "name": {
      "type": "string",
      "description": "Display name shown on the browse card (e.g. 'Toyota Prado VXR 2022')"
    },
    "brand": {
      "type": "string",
      "description": "Vehicle brand / make (Toyota, Mercedes Benz, Lexus, Range Rover, etc.)"
    },
    "category": {
      "type": "string",
      "enum": [
        "economy",
        "comfort",
        "suv",
        "executive",
        "luxury"
      ],
      "description": "Price tier \u2014 step 2 of the browse flow (city \u2192 category \u2192 car). Replaced the old body-style vehicle_type enum: guests shop by budget, not by shape. Group size is expressed through max_passengers instead. Keep in lockstep with CATEGORIES in src/config/rides.js."
    },
    "powertrain": {
      "type": "string",
      "enum": [
        "petrol",
        "diesel",
        "hybrid",
        "electric"
      ],
      "description": "What drives the vehicle. Kept apart from category on purpose: an electric car can sit in any price tier. Optional, no default: unset means nobody has said. Guests see an Electric badge when it is 'electric'. Keep in lockstep with POWERTRAINS in src/config/rides.js."
    },
    "model_year": {
      "type": "number",
      "description": "Year of manufacture (e.g. 2022)"
    },
    "description": {
      "type": "string",
      "description": "Free-text description shown on the detail page"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs of vehicle photos. Minimum 5 recommended."
    },
    "videos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Optional walk-through video URLs."
    },
    "city": {
      "type": "string",
      "description": "City where the vehicle is based. Deliberately not an enum \u2014 the client expects to keep adding cities, and an enum makes that a multi-schema migration each time. The allowed list lives in src/config/rides.js and every admin dropdown is bound to it."
    },
    "registration_number": {
      "type": "string",
      "description": "Number plate. Internal until the guest has paid AND a driver is assigned, at which point getRideDriverContact includes it in the handoff so the guest can identify the car on pickup."
    },
    "price_per_hour_ngn": {
      "type": "number",
      "description": "Hourly rate in NGN. Required for any booking shorter than a full day \u2014 a vehicle without one cannot take hourly bookings at all and the UI greys those durations out."
    },
    "price_extra_hour_ngn": {
      "type": "number",
      "description": "Rate for each hour the guest keeps the car beyond what they booked (3 hours booked, 4 used \u2192 one extra hour at this rate). Disclosed to the guest before they request, snapshotted onto RideBooking.extra_hour_rate_ngn at request time, and settled by admin after the trip. Falls back to price_per_hour_ngn when unset \u2014 see extraHourRate in src/config/rides.js."
    },
    "price_12hr_ngn": {
      "type": "number",
      "description": "Price for a 12-hour booking in NGN"
    },
    "price_24hr_ngn": {
      "type": "number",
      "description": "Price for a 24-hour booking in NGN"
    },
    "price_per_extra_day_ngn": {
      "type": "number",
      "description": "Price per additional day past the first 24h in NGN (used for multi-day bookings)"
    },
    "price_per_week_ngn": {
      "type": "number",
      "description": "Optional weekly rate \u2014 Phase 2 feature, fall back to 7x daily if unset"
    },
    "price_per_month_ngn": {
      "type": "number",
      "description": "Optional monthly rate \u2014 Phase 2 feature"
    },
    "max_passengers": {
      "type": "number",
      "description": "Seat capacity (excluding the driver)"
    },
    "amenities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Features: air_conditioning, leather_seats, wifi, child_seat, bottled_water, sound_system, tinted_windows, executive_partition"
    },
    "driver_included": {
      "type": "boolean",
      "default": true,
      "description": "Always true for V1 \u2014 every hire comes with a driver from the Driver pool. Kept as a field for future self-drive support."
    },
    "fuel_policy": {
      "type": "string",
      "enum": [
        "fuel_included",
        "guest_pays_fuel",
        "fuel_capped"
      ],
      "description": "Who covers fuel"
    },
    "fuel_cap_daily_ngn": {
      "type": "number",
      "description": "If fuel_policy='fuel_capped', the daily cap in NGN before guest pays."
    },
    "pickup_locations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Areas / neighborhoods the vehicle can pick up from (Maitama, Wuse, VI, Lekki, NAIA, MMA, etc.)"
    },
    "service_area": {
      "type": "string",
      "description": "Free-text description of where the vehicle can take you (e.g. 'Anywhere in Abuja + Suleja. Inter-state on request.')"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Admin toggle \u2014 false hides from the browse page without deleting the row"
    },
    "admin_approved": {
      "type": "boolean",
      "default": false,
      "description": "Admin must explicitly approve a vehicle before it appears in the browse list. Only an admin may write it: a listings helper can add and edit vehicles (the create and update rules let them), and a vehicle a helper adds waits here, unapproved, for an admin.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "rating": {
      "type": "number",
      "default": 0,
      "description": "Average rating 0-5"
    },
    "reviews_count": {
      "type": "number",
      "default": 0
    },
    "min_hours_per_booking": {
      "type": "number",
      "default": 1,
      "description": "Minimum hours a guest can book. Was 12 before hourly hire existed \u2014 any row still carrying 12 will reject every hourly booking, so existing vehicles must be backfilled."
    },
    "turnaround_hours": {
      "type": "number",
      "default": 1,
      "description": "Gap the vehicle needs between hires (cleaning, refuelling, getting across town). Replaced a hardcoded 2h constant: a 2h buffer either side of a 1h booking would cap a car at roughly three hires a day."
    }
  },
  "required": [
    "name",
    "brand",
    "category",
    "city",
    "price_12hr_ngn",
    "price_24hr_ngn",
    "images"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "listing_helper"
          }
        }
      ]
    },
    "read": {},
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "listing_helper"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}