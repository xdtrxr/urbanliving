{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "profile_picture": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "phone_number": {
      "type": "string"
    },
    "travel_style": {
      "type": "string",
      "enum": [
        "luxury",
        "budget",
        "adventure",
        "business",
        "family",
        "romantic"
      ]
    },
    "interests": {
      "type": "string"
    },
    "loyalty_points": {
      "type": "number",
      "default": 0
    },
    "loyalty_tier": {
      "type": "string",
      "enum": [
        "Bronze",
        "Silver",
        "Gold",
        "Platinum",
        "Diamond"
      ],
      "default": "Bronze"
    },
    "wishlist": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "referral_code": {
      "type": "string"
    },
    "referred_by_code": {
      "type": "string"
    },
    "referral_balance_ngn": {
      "type": "number",
      "default": 0
    },
    "referral_prompt_seen": {
      "type": "boolean",
      "default": false,
      "description": "Has the user already been prompted to enter a referral code"
    },
    "nft_tokens": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "rarity": {
            "type": "string"
          },
          "earned_date": {
            "type": "string"
          },
          "image_url": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "benefits": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "description": "NFT collectibles awarded to the user"
    },
    "push_subscriptions": {
      "type": "array",
      "description": "Web Push API subscription objects. Each entry stores the user's browser/PWA push endpoint + p256dh / auth keys so the server can encrypt and POST a notification to their device. Owned by savePushSubscription (append) and removePushSubscription (delete-by-endpoint). Service-role only — users never write each other's entries.",
      "items": {
        "type": "object",
        "properties": {
          "endpoint": {
            "type": "string",
            "description": "Push service URL the browser handed us at subscribe time. Acts as the unique key for this subscription."
          },
          "expirationTime": {
            "type": ["number", "null"],
            "description": "Some browsers may set this; usually null."
          },
          "keys": {
            "type": "object",
            "properties": {
              "p256dh": {
                "type": "string",
                "description": "Base64url-encoded client public key for ECDH."
              },
              "auth": {
                "type": "string",
                "description": "Base64url-encoded auth secret used by the encrypted payload envelope."
              }
            }
          },
          "label": {
            "type": "string",
            "description": "Human-readable label set by the client (e.g. \"iPhone PWA\", \"Chrome desktop\") so users can tell devices apart in settings later."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "required": []
}