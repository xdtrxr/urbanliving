{
  "name": "WithdrawalRequest",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the user requesting withdrawal"
    },
    "bank_account_id": {
      "type": "string",
      "description": "Reference to the UserBankAccount used for this withdrawal"
    },
    "amount": {
      "type": "number",
      "description": "Amount to withdraw in NGN"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "completed",
        "failed",
        "reversed"
      ],
      "default": "pending",
      "description": "Current status of the withdrawal"
    },
    "transfer_code": {
      "type": "string",
      "description": "Paystack transfer code/reference"
    },
    "transfer_id": {
      "type": "string",
      "description": "Paystack transfer ID"
    },
    "error_message": {
      "type": "string",
      "description": "Error details if the withdrawal failed"
    },
    "requested_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the withdrawal was requested"
    },
    "processed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the withdrawal was completed/failed"
    },
    "admin_notes": {
      "type": "string",
      "description": "Internal notes from admin review"
    }
  },
  "required": [
    "user_email",
    "bank_account_id",
    "amount"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}