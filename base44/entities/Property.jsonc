{
  "name": "Property",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Property title"
    },
    "description": {
      "type": "string",
      "description": "Detailed property description"
    },
    "location": {
      "type": "object",
      "properties": {
        "city": {
          "type": "string"
        },
        "country": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "coordinates": {
          "type": "object",
          "properties": {
            "lat": {
              "type": "number"
            },
            "lng": {
              "type": "number"
            }
          }
        }
      }
    },
    "price_per_night": {
      "type": "number",
      "description": "Price per night in NGN"
    },
    "caution_fee": {
      "type": "number",
      "description": "Refundable caution fee in NGN",
      "default": 0
    },
    "currency": {
      "type": "string",
      "default": "NGN",
      "description": "The currency of the price (always NGN)"
    },
    "max_guests": {
      "type": "number",
      "description": "Maximum number of guests"
    },
    "bedrooms": {
      "type": "number"
    },
    "bathrooms": {
      "type": "number"
    },
    "property_type": {
      "type": "string",
      "enum": [
        "apartment",
        "house",
        "studio",
        "loft",
        "penthouse",
        "villa"
      ]
    },
    "amenities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "wifi",
          "kitchen",
          "parking",
          "pool",
          "gym",
          "balcony",
          "air_conditioning",
          "heating",
          "washer",
          "dryer",
          "pets_allowed",
          "smoking_allowed",
          "workspace"
        ]
      }
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of image URLs"
    },
    "videos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of video URLs",
      "default": []
    },
    "rating": {
      "type": "number",
      "minimum": 0,
      "maximum": 5
    },
    "reviews_count": {
      "type": "number",
      "default": 0
    },
    "host_name": {
      "type": "string"
    },
    "instant_book": {
      "type": "boolean",
      "default": false
    },
    "external_id": {
      "type": "string",
      "description": "Unique ID from the source (manual_123, file_456, etc.)"
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "file_upload"
      ],
      "description": "Source of the property data"
    }
  },
  "required": [
    "title",
    "location",
    "price_per_night",
    "max_guests",
    "property_type"
  ],
  "rls": {
    "read": null,
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}