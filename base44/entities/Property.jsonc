{
  "name": "Property",
  "type": "object",
  "description": "A short-let listing. Public read; every write is admin-only (listings are managed from the Admin page and by mcpDataIngestion under the service role). Rules are stated per operation rather than as a single legacy 'write' key so the per-operation RLS model enforces them.",
  "properties": {
    "title": {
      "type": "string",
      "description": "Property title"
    },
    "description": {
      "type": "string",
      "description": "Detailed property description"
    },
    "location": {
      "type": "object",
      "properties": {
        "city": {
          "type": "string"
        },
        "country": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "coordinates": {
          "type": "object",
          "properties": {
            "lat": {
              "type": "number"
            },
            "lng": {
              "type": "number"
            }
          }
        }
      }
    },
    "price_per_night": {
      "type": "number",
      "description": "Price per night in NGN"
    },
    "caution_fee": {
      "type": "number",
      "description": "Refundable caution fee in NGN",
      "default": 0
    },
    "currency": {
      "type": "string",
      "default": "NGN",
      "description": "The currency of the price (always NGN)"
    },
    "max_guests": {
      "type": "number",
      "description": "Maximum number of guests"
    },
    "bedrooms": {
      "type": "number"
    },
    "booking_options": {
      "type": "array",
      "description": "The ways this property can be booked, by bedroom count. Empty means one way: the whole place at price_per_night for up to max_guests. When set, price_per_night and max_guests on the row are kept as the LARGEST option's (the whole place), so anything that reads only those two quotes a real offer and never a small option's price for the whole house.",
      "items": {
        "type": "object",
        "properties": {
          "bedrooms": { "type": "number" },
          "price_per_night": { "type": "number", "description": "NGN" },
          "max_guests": { "type": "number" }
        }
      }
    },
    "seasonal_rates": {
      "type": "array",
      "description": "Named date ranges with their own nightly prices. start_date and end_date are inclusive nights (YYYY-MM-DD). A season changes only the options it prices; ranges on one property do not overlap.",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "start_date": { "type": "string", "format": "date" },
          "end_date": { "type": "string", "format": "date" },
          "prices": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "bedrooms": { "type": "number" },
                "price_per_night": { "type": "number", "description": "NGN" }
              }
            }
          }
        }
      }
    },
    "bathrooms": {
      "type": "number"
    },
    "property_type": {
      "type": "string",
      "enum": [
        "apartment",
        "house",
        "studio",
        "loft",
        "penthouse",
        "villa"
      ]
    },
    "amenities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "wifi",
          "kitchen",
          "parking",
          "pool",
          "gym",
          "balcony",
          "air_conditioning",
          "heating",
          "washer",
          "dryer",
          "pets_allowed",
          "smoking_allowed",
          "workspace"
        ]
      }
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of image URLs"
    },
    "videos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of video URLs",
      "default": []
    },
    "rating": {
      "type": "number",
      "minimum": 0,
      "maximum": 5
    },
    "reviews_count": {
      "type": "number",
      "default": 0
    },
    "host_name": {
      "type": "string"
    },
    "host_phone": {
      "type": "string",
      "description": "Phone number guest can call on arrival (international format preferred)"
    },
    "arrival_instructions": {
      "type": "string",
      "description": "Free-form text shown to guest after payment (gate code, parking notes, key handover, etc.)"
    },
    "instant_book": {
      "type": "boolean",
      "default": false
    },
    "external_id": {
      "type": "string",
      "description": "Unique ID from the source (manual_123, file_456, etc.)"
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "file_upload"
      ],
      "description": "Source of the property data"
    }
  },
  "required": [
    "title",
    "location",
    "price_per_night",
    "max_guests",
    "property_type"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}