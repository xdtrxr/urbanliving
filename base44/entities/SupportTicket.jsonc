{
  "name": "SupportTicket",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the user who created the ticket"
    },
    "subject": {
      "type": "string",
      "description": "Subject/title of the support ticket"
    },
    "category": {
      "type": "string",
      "enum": [
        "booking",
        "payment",
        "account",
        "technical",
        "general"
      ],
      "description": "Category of the support request"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium",
      "description": "Priority level of the ticket"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "resolved",
        "closed"
      ],
      "default": "open",
      "description": "Current status of the ticket"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of the issue"
    },
    "ai_handled": {
      "type": "boolean",
      "default": false,
      "description": "Whether the ticket was handled by AI or needs human intervention"
    },
    "resolution": {
      "type": "string",
      "description": "Resolution provided for the ticket"
    },
    "satisfaction_rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "User satisfaction rating (1-5 stars)"
    }
  },
  "required": [
    "user_email",
    "subject",
    "category",
    "description"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}